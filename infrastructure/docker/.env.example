# Vaultz Local Development Database Configuration
# Copy this file to .env before starting Docker Compose:
#   Copy-Item infrastructure/docker/.env.example infrastructure/docker/.env
# Never put real production credentials in this file.

POSTGRES_USER=vaultz
POSTGRES_PASSWORD=vaultz_local_dev_password_change_me
POSTGRES_DB=vaultz_dev
POSTGRES_PORT=5432

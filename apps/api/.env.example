# Vaultz Backend API (.NET 10) — Production Environment Template
# Copy/inject these via your cloud secret manager or deployment environment; never commit real secrets.

ASPNETCORE_ENVIRONMENT=Production

# PostgreSQL 17 connection string (must NOT contain the local dev password)
ConnectionStrings__DefaultConnection=Host=db.example.com;Port=5432;Database=vaultz_prod;Username=vaultz_app;Password=CHANGE_ME_STRONG_POSTGRES_PASSWORD;SSL Mode=Require

# HMAC-SHA256 signing key (minimum 32 random bytes; must NOT use the dev key)
Jwt__SigningKey=CHANGE_ME_MINIMUM_32_BYTE_RANDOM_JWT_SIGNING_SECRET
Jwt__Issuer=Vaultz.Api
Jwt__Audience=Vaultz.Web

# Live Resend transactional email credentials
Resend__Enabled=true
Resend__ApiKey=re_CHANGE_ME_LIVE_RESEND_API_KEY
Resend__FromEmail=noreply@your-verified-domain.com
Resend__FromName=Vaultz Security

# HTTPS frontend origin for email verification & password reset links
App__FrontendBaseUrl=https://app.your-domain.com

# Explicit CORS allowed frontend origins (no wildcards)
Cors__AllowedOrigins__0=https://app.your-domain.com

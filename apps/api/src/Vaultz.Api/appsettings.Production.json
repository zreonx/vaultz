{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "App": {
    "FrontendBaseUrl": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Jwt": {
    "Issuer": "Vaultz.Api",
    "Audience": "Vaultz.Web",
    "SigningKey": "",
    "ExpirationMinutes": 10080,
    "CookieName": "vaultz.jwt"
  },
  "Resend": {
    "Enabled": true,
    "ApiKey": "",
    "FromEmail": "noreply@vaultz.app",
    "FromName": "Vaultz Security"
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  }
}
